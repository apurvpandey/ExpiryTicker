<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome adaptive icon — Material You themed icons (API 33+).
    The system tints all opaque pixels with the user's wallpaper-extracted colour.
    Structure mirrors the foreground: evenOdd frame (transparent body) + bold tick.
    Fill colour is irrelevant; only opacity matters for monochrome tinting.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left binding tab -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M31,18 Q31,14 36,14 Q41,14 41,18 L41,34 Q41,36 36,36 Q31,36 31,34 Z"/>

    <!-- Right binding tab -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M67,18 Q67,14 72,14 Q77,14 77,18 L77,34 Q77,36 72,36 Q67,36 67,34 Z"/>

    <!-- Calendar frame + transparent body (evenOdd) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M18,34 Q18,26 26,26 L82,26 Q90,26 90,34 L90,84 Q90,94 82,94 L26,94 Q18,94 18,84 Z
                          M22,46 L86,46 L86,84 Q86,90 82,90 L26,90 Q22,90 22,84 Z"/>

    <!-- Bold check mark -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M28,71 L44,87 L80,54"/>
</vector>
