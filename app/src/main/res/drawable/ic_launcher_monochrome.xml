<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome adaptive icon — used for Material You themed icons (API 33+).
    The system tints all opaque pixels with the user's theme colour.
    Uses evenOdd fill to punch a transparent window in the calendar body,
    so only the frame + header + binding tabs + checkmark are tinted.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Binding tabs -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,16 Q32,12 36,12 Q40,12 40,16 L40,32 Q40,36 36,36 Q32,36 32,32 Z"/>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M68,16 Q68,12 72,12 Q76,12 76,16 L76,32 Q76,36 72,36 Q68,36 68,32 Z"/>

    <!--
        Calendar frame — evenOdd fill so the inner subpath is transparent.
        Outer: calendar rounded rect. Inner subpath: inner body area.
        Together they render only the border + header strip.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M20,34 Q20,26 28,26 L80,26 Q88,26 88,34 L88,84 Q88,92 80,92 L28,92 Q20,92 20,84 Z
                          M24,46 L84,46 L84,84 Q84,88 80,88 L28,88 Q24,88 24,84 Z"/>

    <!-- Checkmark inside the transparent body area -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M31,68 L46,83 L77,53"/>
</vector>
