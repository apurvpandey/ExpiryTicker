<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome adaptive icon — Material You themed icons (API 33+).
    Calendar frame + check mark. Single-color silhouette, no gradients.
    108x108dp canvas; key artwork in 72dp safe zone (18dp padding each side).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Calendar binding tabs -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,18 Q38,14 42,14 Q46,14 46,18 L46,26 Q46,28 42,28 Q38,28 38,26 Z"/>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,18 Q62,14 66,14 Q70,14 70,18 L70,26 Q70,28 66,28 Q62,28 62,26 Z"/>

    <!-- Calendar frame (evenOdd punches out body so background shows) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M22,26 Q22,20 28,20 L80,20 Q86,20 86,26 L86,84 Q86,90 80,90 L28,90 Q22,90 22,84 Z
                          M26,38 L82,38 L82,84 Q82,86 80,86 L28,86 Q26,86 26,84 Z"/>

    <!-- Check mark in lower-right, bold strokes -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M42,64 L52,74 L68,52"/>

</vector>
