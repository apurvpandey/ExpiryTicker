<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android may copy to the user's Google backup (Android 12+) or to a new device.
  Attachments are left out of the cloud backup: they can be large and would eat the 25 MB
  quota, which stops backups altogether when exceeded. The app's own "Back up everything"
  export includes them, and a direct device-to-device transfer keeps them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="attachments/" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
