<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main app theme — Material 3 DayNight, no action bar -->
    <style name="Theme.ExpiryTicker" parent="Theme.Material3.DayNight.NoActionBar" />

    <!--
        Starting (splash) theme applied to MainActivity via the manifest.
        postSplashScreenTheme hands off to the main theme once the splash exits.
        windowSplashScreenAnimatedIcon uses the adaptive foreground vector scaled
        to 80% of the splash window per the SplashScreen API specification.
    -->
    <style name="Theme.ExpiryTicker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1520CC</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#1520CC</item>
        <item name="postSplashScreenTheme">@style/Theme.ExpiryTicker</item>
    </style>
</resources>
