<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — 108×108dp, safe zone 18–90 (72dp centred).
    Design: white calendar frame with binding tabs; indigo inner body
    (matches background layer so it reads as a transparent window);
    white checkmark tick inside the body.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Binding tabs — two pill-shaped white tabs that protrude above
        the calendar top edge, simulating real calendar ring binding.
        Left tab centred at x=36, right at x=72.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,16 Q32,12 36,12 Q40,12 40,16 L40,32 Q40,36 36,36 Q32,36 32,32 Z"/>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M68,16 Q68,12 72,12 Q76,12 76,16 L76,32 Q76,36 72,36 Q68,36 68,32 Z"/>

    <!--
        Calendar outer frame — white rounded rectangle (rx=8).
        Spans x:20–88, y:26–92. The 4 dp border around the inner
        body and the 20 dp white header area are both part of this shape.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20,34 Q20,26 28,26 L80,26 Q88,26 88,34 L88,84 Q88,92 80,92 L28,92 Q20,92 20,84 Z"/>

    <!--
        Calendar inner body — painted indigo to match the background layer,
        creating the visual "window" effect inside the calendar frame.
        Top edge is flush with the header boundary (y=46); bottom corners rx=4.
    -->
    <path
        android:fillColor="#1953CC"
        android:pathData="M24,46 L84,46 L84,84 Q84,88 80,88 L28,88 Q24,88 24,84 Z"/>

    <!--
        Checkmark — thick white stroke with round caps, centred in the
        indigo body area. Reads as "renewed / completed".
    -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M31,68 L46,83 L77,53"/>
</vector>
