<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — 108×108dp canvas; safe zone 18–90 (72dp centred).
    Concept: calendar frame + hourglass (time/expiry).
    The inner body is transparent (evenOdd) so the background gradient shows through.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left binding tab — pill centred at x=36, y:14–36 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M31,18 Q31,14 36,14 Q41,14 41,18 L41,34 Q41,36 36,36 Q31,36 31,34 Z"/>

    <!-- Right binding tab — pill centred at x=72, y:14–36 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M67,18 Q67,14 72,14 Q77,14 77,18 L77,34 Q77,36 72,36 Q67,36 67,34 Z"/>

    <!--
        Calendar frame (white) with body punched out via evenOdd.
        Outer rect: x:18–90, y:26–94, corner radius ≈ 8.
        Inner cutout: body area y:46–90, inset 4dp each side.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M18,34 Q18,26 26,26 L82,26 Q90,26 90,34 L90,84 Q90,94 82,94 L26,94 Q18,94 18,84 Z
                          M22,46 L86,46 L86,84 Q86,90 82,90 L26,90 Q22,90 22,84 Z"/>

    <!--
        Hourglass centred in the transparent body (body: x:22–86, y:46–90, centre y=68).
        Top triangle: tip at (54,52), base across y=66.
        Waist: 8dp wide connector between y=66 and y=72.
        Bottom triangle: base across y=72, tip at (54,86).
        Total height 34dp, width 28dp at widest — bold and readable at 48dp icon size.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,52 L40,66 L68,66 Z"/>

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,66 L58,66 L58,72 L50,72 Z"/>

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,86 L40,72 L68,72 Z"/>

</vector>
