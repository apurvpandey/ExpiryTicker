<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — 108×108dp canvas; safe zone 18–90 (72dp centred).
    Concept: calendar frame + renewal tick.
    The inner body is transparent (evenOdd) so the background colour shows through.
    No hardcoded colour-matching between foreground and background layers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left binding tab — pill centred at x=36, y:14–36 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M31,18 Q31,14 36,14 Q41,14 41,18 L41,34 Q41,36 36,36 Q31,36 31,34 Z"/>

    <!-- Right binding tab — pill centred at x=72, y:14–36 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M67,18 Q67,14 72,14 Q77,14 77,18 L77,34 Q77,36 72,36 Q67,36 67,34 Z"/>

    <!--
        Calendar frame (white) with body punched out via evenOdd.
        Outer rect: x:18–90, y:26–94, corner radius ≈ 8.
        Inner cutout: body area y:46–90 (header strip y:26–46 stays white).
        The resulting shape is a U-shaped header + 4-dp side/bottom border.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M18,34 Q18,26 26,26 L82,26 Q90,26 90,34 L90,84 Q90,94 82,94 L26,94 Q18,94 18,84 Z
                          M22,46 L86,46 L86,84 Q86,90 82,90 L26,90 Q22,90 22,84 Z"/>

    <!--
        Bold check mark — white rounded stroke, centred in the transparent body area.
        Body spans y:46–94; visual centre ≈ y=70.
    -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M28,71 L44,87 L80,54"/>
</vector>
